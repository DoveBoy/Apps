{
    "version": "5.1.0",
    "description": "A lightweight Markdown and plain text editor built with Tauri 2.",
    "homepage": "https://solomd.app",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/zhitongblog/solomd/releases/download/v5.1.0/SoloMD_5.1.0_x64_en-US.msi",
            "hash": "826fca8798344b58f8890dcecb14b979a54ceef6fb733e03fd46dfc33e255a40"
        },
        "arm64": {
            "url": "https://github.com/zhitongblog/solomd/releases/download/v5.1.0/SoloMD_5.1.0_arm64_en-US.msi",
            "hash": "aef6a4f21d490dce29bc51bcb87d0bceeb5e727c4d9703657ba8df01f7c518cd"
        }
    },
    "extract_dir": "PFiles\\SoloMD",
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:LOCALAPPDATA\\app.solomd\"",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\userdata\" -Target \"$env:APPDATA\\app.solomd\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:LOCALAPPDATA\\app.solomd\"",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\app.solomd\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": "SoloMD.exe",
    "shortcuts": [
        [
            "SoloMD.exe",
            "SoloMD"
        ]
    ],
    "checkver": {
        "github": "https://github.com/zhitongblog/solomd"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zhitongblog/solomd/releases/download/v$version/SoloMD_$version_x64_en-US.msi"
            },
            "arm64": {
                "url": "https://github.com/zhitongblog/solomd/releases/download/v$version/SoloMD_$version_arm64_en-US.msi"
            }
        }
    }
}
