{
    "version": "3.1.0",
    "description": "Breeze 是一款使用flutter构建的漫画阅读器，通过插件提供漫画支持，现支持哔咔，禁漫，ehentai，nhentai再漫画，拷贝漫画，NoyAcg，komiic，包子漫画，绅士漫画。",
    "homepage": "https://github.com/breeze-project-org/Breeze",
    "license": {
        "identifier": "MPL-2.0 license",
        "url": "https://github.com/breeze-project-org/Breeze#MPL-2.0-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/breeze-project-org/Breeze/releases/download/v3.1.0/windows-installer-v3.1.0.exe",
            "hash": "db702714b992a5284c480ce1536251521845e9aac36aeeb9f5b194c5be19d83e"
        }
    },
    "innosetup": true,
    "pre_install": [
        "if (Test-Path \"$dir\\Release\") {",
        "    Get-ChildItem -Path \"$dir\\Release\" -Force | Move-Item -Destination $dir -Force",
        "    Remove-Item -Path \"$dir\\Release\" -Recurse -Force",
        "}",
    ],
    "bin": [
        [
            "zephyr.exe",
            "Breeze"
        ]
    ],
    "shortcuts": [
        [
            "zephyr.exe",
            "Breeze"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/breeze-project-org/Breeze/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/breeze-project-org/Breeze/releases/download/v$version/windows-installer-v$version.exe"
            }
        }
    }
}
