{
    "version": "0.5.25",
    "description": "由 Pilipala 开发的 Android 电视播放器。仅提供工具，不含影视资源；内容和配置由用户自行合法获取。",
    "homepage": "https://github.com/Pilipala9919/MarcoMovie",
    "license": {
        "identifier": "GPL-3.0 license",
        "url": "https://github.com/Pilipala9919/MarcoMovie#GPL-3.0-1-ov-file"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/Pilipala9919/MarcoMovie/releases/download/windows-v0.5.25/MarcoMovie-0.5.25-windows-x64.zip",
            "hash": "db1a5b21d3b06bd70c140e3da504ef40bde4d225f221e41db2e3e39e6da3d2e2"
        }
    },
    "installer": {
        "script": [
            "# handle runtime cache",
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Mount-ExternalRuntimeData -Source \"$persist_dir\\appdata\" -Target \"$env:APPDATA\\com.example\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "uninstaller": {
        "script": [
            "Import-Module $(Join-Path $(Find-BucketDirectory -Root -Name apps) scripts/AppsUtils.psm1)",
            "Dismount-ExternalRuntimeData -Target \"$env:APPDATA\\com.example\"",
            "Remove-Module -Name AppsUtils"
        ]
    },
    "bin": [
        [
            "marco_movie.exe",
            "MarcoMovie"
        ]
    ],
    "shortcuts": [
        [
            "marco_movie.exe",
            "MarcoMovie"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/Pilipala9919/MarcoMovie/releases",
        "jp": "$[*].tag_name",
        "regex": "windows-v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Pilipala9919/MarcoMovie/releases/download/windows-v$version/MarcoMovie-$version-windows-x64.zip"
            }
        },
        "hash": {
            "url": "$baseurl/$basename.sha256"
        }
    }
}
